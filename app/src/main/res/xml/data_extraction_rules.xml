<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
          vektor_go_secure.db holds the ARCA/AFIP signing private key
          (privateKeyPem), the Mercado Pago access token, and the webhook
          secret. It's SQLCipher-encrypted, but exclude it from cloud backup
          anyway rather than relying on that alone.
        -->
        <exclude domain="database" path="vektor_go_secure.db" />
        <exclude domain="database" path="vektor_go_secure.db-wal" />
        <exclude domain="database" path="vektor_go_secure.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="vektor_go_secure.db" />
        <exclude domain="database" path="vektor_go_secure.db-wal" />
        <exclude domain="database" path="vektor_go_secure.db-shm" />
    </device-transfer>
</data-extraction-rules>
