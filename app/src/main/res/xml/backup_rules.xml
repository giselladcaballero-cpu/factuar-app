<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
      vektor_go_secure.db holds the ARCA/AFIP signing private key and the
      Mercado Pago access token — never back it up (API < 31 path).
    -->
    <exclude domain="database" path="vektor_go_secure.db" />
    <exclude domain="database" path="vektor_go_secure.db-wal" />
    <exclude domain="database" path="vektor_go_secure.db-shm" />
</full-backup-content>
